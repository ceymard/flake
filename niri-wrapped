#!/usr/bin/env bash

# Set up home-manager environment paths
export PATH="$HOME/.nix-profile/bin:/etc/profiles/per-user/$USER/bin:$PATH"
export XDG_DATA_DIRS="$HOME/.nix-profile/share:$HOME/.local/share:/usr/local/share:/usr/share"

# Set XDG environment variables for Wayland
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=niri
export XDG_SESSION_DESKTOP=niri

# Set Wayland display (niri will set this, but we initialize it)
# export WAYLAND_DISPLAY=wayland-1

# Qt/GTK Wayland support
export QT_QPA_PLATFORM=wayland
export GDK_BACKEND=wayland
export MOZ_ENABLE_WAYLAND=1

# Disable X11 fallback for initial launch
unset DISPLAY

# Import environment to systemd before starting niri
systemctl --user import-environment PATH XDG_DATA_DIRS XDG_SESSION_TYPE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP QT_QPA_PLATFORM GDK_BACKEND MOZ_ENABLE_WAYLAND

# Auto-detect GPU and use appropriate nixGL wrapper
